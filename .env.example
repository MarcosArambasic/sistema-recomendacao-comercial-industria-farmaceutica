# Copie este arquivo para .env e preencha com as suas chaves.
# Nenhuma chave é necessária para reproduzir a base sintética, o Agente 3 e as métricas.

# Coleta de notícias (missão "noticias")
API_KEY_GNEWS_TESTE=
API_KEY_GNEWS_PRODUCAO_1=
API_KEY_GUARDIAN=

# Opcional: geração textual com LLM no Agente 5 / painel
OPENAI_API_KEY=
OPENAI_MODELO=
PAINEL_USAR_LLM=0

# Opcional: Desempate com modelo local (Ollama)
OLLAMA_HOST=http://localhost:11434
DESEMPATE_MODELO=llama3.1

# Opcional: carga no Supabase/PostgreSQL
DATABASE_URL=
